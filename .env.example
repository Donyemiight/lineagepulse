# ── DataHub ───────────────────────────────────────────────────────────────
# Local quickstart:
#   DATAHUB_GMS_URL=http://localhost:8080
# DataHub Cloud:
#   DATAHUB_GMS_URL=https://<tenant>.acryl.io
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token. Local: Settings → Access Tokens. Cloud: Settings → Personal Access Tokens.
DATAHUB_TOKEN=

# Allow the agent to write incident Documents back to DataHub.
DATAHUB_MUTATIONS_ENABLED=true

# ── LLM ───────────────────────────────────────────────────────────────────
# Pick ONE provider and fill the matching key. Anthropic recommended.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

LLM_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.1

# ── Slack ─────────────────────────────────────────────────────────────────
# Incoming webhook URL. https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#data-incidents

# Optional: per-domain channel routing. JSON map, e.g. {"Finance":"#finance-data"}
SLACK_CHANNEL_ROUTING=

# ── Agent behavior ────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300
LINEAGE_DEPTH=3
DRY_RUN=true

# ── Misc ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
